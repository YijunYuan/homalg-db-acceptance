iki-dark:#6A737D\">-/</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">namespace</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> Fixture2000</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"--shiki-light:#6A737D;--shiki-dark:#6A737D\">/-- **Lemma 1** (Fixture2000). Since multiplication by one fixes each natural number,</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#6A737D;--shiki-dark:#6A737D\">replace the right side by the degree and apply reflexivity of the order. -/</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">theorem</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\"> degree_le_mul_one</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> (c : ChainComplexToy) : c.degree ≤ c.degree * </span><span style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> := </span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">by</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#B31D28;--shiki-light-font-style:italic;--shiki-dark:#FDAEB7;--shiki-dark-font-style:italic\">  sorry</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">end</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> Fixture2000</span></span>\n<span class=\"line\"></span></code></pre>",
    "source_text": "import HomAlg.Fixture2000.Def_1\n\n/-!\n```yaml node\n{\n  \"id\": \"Fixture2000.Lem_1\",\n  \"kind\": \"lemma\",\n  \"doc\": \"Fixture2000\",\n  \"source\": {\n    \"chapter\": \"1\",\n    \"section\": \"1.1\",\n    \"label\": \"Lemma 1\",\n    \"pages\": [\n      2\n    ]\n  },\n  \"title\": \"Lemma 1\",\n  \"tags\": [\n    \"chain-complex\",\n    \"basic\"\n  ],\n  \"concepts\": {\n    \"defines\": [],\n    \"uses\": []\n  },\n  \"deps\": {\n    \"statement\": [\n      \"Fixture2000.Def_1\"\n    ],\n    \"proof\": []\n  },\n  \"decls\": [\n    \"Fixture2000.degree_le_mul_one\"\n  ],\n  \"fidelity\": {\n    \"status\": \"faithful\"\n  },\n  \"nl_proof_source\": {\n    \"follows\": \"document\"\n  }\n}\n```\n\n## Statement\n\nFor every toy chain complex $C$, its degree satisfies $\\deg C \\leq (\\deg C)\\cdot 1$.\n\n## Proof\n\nMultiplication by one fixes every natural number. The assertion therefore follows from reflexivity of the order.\n\n## Description\n\nAn elementary bound whose deliberately deferred proof tests direct sorry detection.\n-/\n\nnamespace Fixture2000\n\n/-- **Lemma 1** (Fixture2000). Since multiplication by one fixes each natural number,\nreplace the right side by the degree and apply reflexivity of the order. -/\ntheorem degree_le_mul_one (c : ChainComplexToy) : c.degree ≤ c.degree * 1 := by\n  sorry\n\nend Fixture2000\n"
